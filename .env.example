# Copy this file to .env and fill in the GitHub credentials and allowed emails.
# Keep .env out of version control. Restart the service after changing it.

# GitHub sign-in
# Use the address you open in your browser, without a path.
# Hosted instances require HTTPS, for example https://traces.example.com.
PUBLIC_BASE_URL=http://localhost:3000

# Create a GitHub OAuth App with PUBLIC_BASE_URL as its homepage.
# Set its callback URL to PUBLIC_BASE_URL followed by /auth/github/callback.
# Local callback: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated verified GitHub emails, for example alice@example.com,bob@example.com.
# Matching ignores case. An empty list blocks all sign-ins.
# Everyone on this list can view and delete traces and manage API keys.
ALLOWED_EMAILS=

# Server
# Listen address when running from source. Compose sets its own container address.
BIND_ADDR=127.0.0.1:3000
# Host port for Docker Compose. Update PUBLIC_BASE_URL and the OAuth App URLs if changed.
TRACES_PORT=3000

# Files
# Paths are relative to the server's working directory.
# Compose overrides these paths and stores the database and backups in its named volume.
# Use a local disk for SQLite and run one instance per database.
DATABASE_PATH=data/traces.sqlite3
STATIC_DIR=web/build
BACKUP_DIR=data/backups

# Days to keep a trace after its last received update. Set to 0 to disable cleanup.
RETENTION_DAYS=30
# Estimated queue memory limit in bytes. Default 64 MiB, allowed range 1 KiB to 1 GiB.
QUEUE_BYTES=67108864

# Optional ingestion token
# Leave blank to use API keys created in the UI.
# If set, this token also allows ingestion. It cannot read or delete traces.
# Remove it and restart the server to revoke it.
TRACE_INGEST_TOKEN=

# Logging
# Use agent_traces=debug for more detail.
RUST_LOG=agent_traces=info
