# Copy to .env. Never commit credentials.
BIND_ADDR=127.0.0.1:3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=data/traces.sqlite3
STATIC_DIR=web/build
BACKUP_DIR=data/backups
RETENTION_DAYS=30
QUEUE_BYTES=67108864
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_EMAILS=
# Optional compatibility credential, independent of UI-managed keys:
TRACE_INGEST_TOKEN=
RUST_LOG=agent_traces=info
